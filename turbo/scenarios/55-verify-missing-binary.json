{
  "name": "verify-missing-binary",
  "description": "Submit runs the scope command. A binary that is not on PATH is an OSError, level failed.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Gate the submit",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "turbo-no-such-binary-xyz",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working"
      }
    },
    {
      "name": "agent acks",
      "op": "ack",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "agent marks ready",
      "op": "ready",
      "expect": {
        "status": 200,
        "ready": true
      }
    },
    {
      "name": "harness exits",
      "op": "tick",
      "release": {
        "exit": 0
      },
      "expect": {
        "state": "working"
      }
    },
    {
      "name": "verify cannot exec",
      "op": "submit",
      "expect": {
        "status": 200,
        "state": "review",
        "verify_level": "failed",
        "verdict": "request-changes",
        "verify_contains": "turbo-no-such-binary-xyz"
      }
    }
  ]
}
