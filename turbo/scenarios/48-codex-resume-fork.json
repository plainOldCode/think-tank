{
  "name": "codex-resume-fork",
  "description": "Codex starts, parses a thread id from its output, resumes that session, and forks when resume exits non-zero.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "codex"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Codex",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "codex",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "codex starts",
      "op": "tick",
      "arm": {
        "alive": false,
        "exit": 0,
        "output": "\nnot-json\n{\"type\":\"thread.started\"}\n"
      },
      "expect": {
        "state": "working",
        "argv0": "codex",
        "argv_contains": [
          "exec",
          "--json",
          "developer_instructions=\""
        ],
        "spawns": 1
      }
    },
    {
      "name": "output has no thread id",
      "op": "tick",
      "expect": {
        "state": "working",
        "session_id": "",
        "spawns": 1
      }
    },
    {
      "name": "agent asks",
      "op": "ask",
      "blocked_question": "Continue?",
      "blocked_options": [
        "yes",
        "no"
      ],
      "blocked_default": "yes",
      "expect": {
        "status": 200,
        "state": "question"
      }
    },
    {
      "name": "turn ends",
      "op": "turn-closed",
      "expect": {
        "status": 200,
        "state": "awaiting-human"
      }
    },
    {
      "name": "human answers",
      "op": "answer",
      "choice": "yes",
      "expect": {
        "status": 200,
        "answer": "yes"
      }
    },
    {
      "name": "resume the codex session",
      "op": "tick",
      "arm": {
        "alive": false,
        "exit": 1,
        "output": ""
      },
      "expect": {
        "state": "working",
        "argv0": "codex",
        "argv_contains": [
          "exec",
          "resume",
          "--json",
          "choice=yes"
        ],
        "spawns": 2
      }
    },
    {
      "name": "resume failure forks",
      "op": "tick",
      "arm": {
        "alive": false,
        "exit": 0,
        "output": "{\"type\":\"thread.started\",\"thread_id\":\"th_9\"}\n"
      },
      "expect": {
        "state": "working",
        "argv0": "codex",
        "argv_contains": [
          "exec",
          "fork",
          "--json"
        ],
        "spawns": 3
      }
    },
    {
      "name": "fork output yields the thread id",
      "op": "tick",
      "expect": {
        "state": "working",
        "session_id": "th_9",
        "spawns": 3
      }
    }
  ]
}
