  "steps": [
    {
      "name": "dry-run does not create the turbo file",
      "op": "module",
      "module": "turbo.migrate",
      "args": ["--legacy", "$legacy", "--turbo", "$turbo", "--dry-run"],
      "expect": {
        "status": 0,
        "turbo_exists": false,
        "text_contains": [
          "\"dry_run\": true",
          "\"mapped\": 10",
          "\"skipped\": 3",
          "\"comments\": 1",
          "T-TODO:open",
          "T-BACK:open",
          "T-BUSY:open",
          "T-Q:awaiting-human",
          "T-DONE:merged",
          "T-REV:review",
          "T-BLK:open",
          "previous assignee: ada",
          "previous lease: old-runner",
          "blocked_detail: needs design",
          "cancelled is not a turbo state",
          "empty title",
          "unknown state",
          "note from the archive"
        ]
      }
    },
    {
      "name": "import into turbo",
      "op": "module",
      "module": "turbo.migrate",
      "args": ["--legacy", "$legacy", "--turbo", "$turbo"],
      "expect": {
        "status": 0,
        "turbo_exists": true,
        "text_contains": ["\"dry_run\": false", "\"mapped\": 10", "\"comments\": 1"]
      }
    },
    {
      "name": "a second dry-run sees the imported ids",
      "op": "module",
      "module": "turbo.migrate",
      "args": ["--legacy", "$legacy", "--turbo", "$turbo", "--dry-run"],
      "expect": {
        "status": 0,
        "turbo_exists": true,
        "text_contains": ["\"dry_run\": true", "\"mapped\": 0", "already imported"]
      }
    },
    {
      "name": "a second import does not duplicate",
      "op": "module",
      "module": "turbo.migrate",
      "args": ["--legacy", "$legacy", "--turbo", "$turbo"],
      "expect": {
        "status": 0,
        "text_contains": ["\"mapped\": 0", "\"skipped\": 13", "\"comments\": 0", "already imported"]
      }
    },
    {
      "name": "a database with no issues table is rejected",
      "op": "module",
      "module": "turbo.migrate",
      "args": ["--legacy", "$empty", "--turbo", "$out2"],
      "expect": {"status": 1, "text_contains": "legacy database has no issues table"}
    },
    {
      "name": "a thin issues table still imports",
      "op": "module",
      "module": "turbo.migrate",
      "args": ["--legacy", "$thin", "--turbo", "$out2"],
      "expect": {
        "status": 0,
        "text_contains": ["THIN1:awaiting-human", "\"mapped\": 1", "\"comments\": 0"]
      }
    }
  ]
}
