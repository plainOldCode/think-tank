{
  "name": "review-without-request-changes",
  "description": "A review card resumes only after request-changes. Approve does not queue a resume.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Gate the submit",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working",
        "assignee": "run-1"
      }
    },
    {
      "name": "agent acks",
      "op": "ack",
      "actor": "worker",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "agent marks ready",
      "op": "ready",
      "expect": {
        "status": 200,
        "ready": true
      }
    },
    {
      "name": "runner submits",
      "op": "submit",
      "expect": {
        "status": 200,
        "state": "review",
        "verify_level": "unit-test-verified"
      }
    },
    {
      "name": "merge before approve",
      "op": "merge",
      "expect": {
        "status": 409,
        "error": "approve",
        "state": "review",
        "no_merge": true
      }
    },
    {
      "name": "probe approves",
      "op": "verdict",
      "result": "approve",
      "expect": {
        "status": 200,
        "verdict": "approve"
      }
    },
    {
      "name": "resume after approve",
      "op": "resume",
      "token": "r-nope",
      "expect": {
        "status": 409,
        "error": "request-changes"
      }
    }
  ]
}
