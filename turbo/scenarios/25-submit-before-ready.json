{
  "name": "submit-before-ready",
  "description": "Submit is rejected until the claimed agent marks the tree ready. A short sha is also rejected.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Gate the submit",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working",
        "assignee": "run-1"
      }
    },
    {
      "name": "agent acks",
      "op": "ack",
      "actor": "worker",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "submit before ready",
      "op": "submit-raw",
      "work_token": "$token",
      "expect": {
        "status": 409,
        "error": "ready",
        "state": "working"
      }
    },
    {
      "name": "agent marks ready",
      "op": "ready",
      "expect": {
        "status": 200,
        "ready": true
      }
    },
    {
      "name": "sha must be 40 hex characters",
      "op": "submit-raw",
      "work_token": "$token",
      "sha": "abc",
      "expect": {
        "status": 422,
        "error": "sha"
      }
    }
  ]
}
