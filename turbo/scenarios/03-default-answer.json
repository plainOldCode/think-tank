{
  "name": "default-answer",
  "description": "Nobody answers. After the deadline the runner applies blocked_default and resumes the same session. The clock jumps; the test does not sleep.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Wait for the default",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working"
      }
    },
    {
      "name": "agent asks",
      "op": "ask",
      "actor": "worker",
      "blocked_question": "Ship it?",
      "blocked_options": [
        "yes",
        "no"
      ],
      "blocked_default": "yes",
      "expect": {
        "state": "question"
      }
    },
    {
      "name": "turn ends",
      "op": "tick",
      "release": {
        "exit": 0
      },
      "expect": {
        "state": "awaiting-human",
        "answer": ""
      }
    },
    {
      "name": "clock passes the 24 hour deadline",
      "op": "advance",
      "seconds": 86405
    },
    {
      "name": "runner applies the default and resumes",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "answer": "yes",
        "answer_by": "default",
        "state": "working",
        "same_session": true,
        "argv_contains": [
          "source=default",
          "choice=yes"
        ]
      }
    }
  ]
}
