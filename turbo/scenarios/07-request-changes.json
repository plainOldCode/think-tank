{
  "name": "request-changes",
  "description": "Verify passed, then the probe requests changes. The card returns to working and the same session resumes.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Fix the review",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working"
      }
    },
    {
      "name": "agent acks",
      "op": "ack",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "agent marks ready",
      "op": "ready",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "harness exits",
      "op": "tick",
      "release": {
        "exit": 0
      },
      "expect": {
        "state": "working"
      }
    },
    {
      "name": "runner submits",
      "op": "submit",
      "expect": {
        "status": 200,
        "state": "review",
        "verify_level": "unit-test-verified",
        "verdict": ""
      }
    },
    {
      "name": "probe requests changes",
      "op": "verdict",
      "result": "request-changes",
      "expect": {
        "status": 200,
        "state": "review",
        "verdict": "request-changes",
        "resume_contains": "next=fix"
      }
    },
    {
      "name": "same session resumes",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working",
        "same_session": true,
        "argv_contains": [
          "--resume",
          "next=fix"
        ]
      }
    }
  ]
}
