{
  "name": "question-answer-resume",
  "description": "The agent leaves a board question, the turn ends, a human answers, and the same session resumes and finishes.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Ask then finish",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working",
        "spawns": 1
      }
    },
    {
      "name": "agent acks",
      "op": "ack",
      "actor": "worker",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "agent asks on the board",
      "op": "ask",
      "actor": "worker",
      "blocked_question": "Ship it?",
      "blocked_options": [
        "yes",
        "no"
      ],
      "blocked_default": "yes",
      "expect": {
        "status": 200,
        "state": "question"
      }
    },
    {
      "name": "turn ends",
      "op": "tick",
      "release": {
        "exit": 0
      },
      "expect": {
        "state": "awaiting-human"
      }
    },
    {
      "name": "human answers",
      "op": "answer",
      "actor": "ada",
      "choice": "no",
      "expect": {
        "status": 200,
        "state": "awaiting-human",
        "answer": "no",
        "answer_by": "ada",
        "resume_contains": "choice=no"
      }
    },
    {
      "name": "same session resumes",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working",
        "same_session": true,
        "argv_contains": [
          "--resume"
        ],
        "spawns": 2
      }
    },
    {
      "name": "agent marks the tree ready again",
      "op": "ready",
      "expect": {
        "status": 200,
        "ready": true
      }
    },
    {
      "name": "resumed turn exits",
      "op": "tick",
      "release": {
        "exit": 0
      },
      "expect": {
        "state": "working",
        "spawns": 2
      }
    },
    {
      "name": "runner submits",
      "op": "submit",
      "expect": {
        "status": 200,
        "state": "review",
        "verify_level": "unit-test-verified"
      }
    },
    {
      "name": "probe approves",
      "op": "verdict",
      "result": "approve",
      "expect": {
        "status": 200,
        "verdict": "approve"
      }
    },
    {
      "name": "runner merges",
      "op": "merge",
      "via": "runner",
      "expect": {
        "status": 200,
        "state": "merged"
      }
    }
  ]
}
