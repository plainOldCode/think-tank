{
  "name": "ready-and-resume-state",
  "description": "Ready is rejected once the card has left working. Resume is rejected while a turn is already working.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Gate the submit",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working",
        "assignee": "run-1"
      }
    },
    {
      "name": "resume while working",
      "op": "resume",
      "token": "r-nope",
      "expect": {
        "status": 409,
        "error": "already running"
      }
    },
    {
      "name": "agent asks",
      "op": "ask",
      "blocked_question": "Ship it?",
      "blocked_options": [
        "yes",
        "no"
      ],
      "blocked_default": "yes",
      "expect": {
        "status": 200,
        "state": "question"
      }
    },
    {
      "name": "resume while questioning",
      "op": "resume",
      "token": "r-nope",
      "expect": {
        "status": 409,
        "error": "not waiting",
        "state": "question"
      }
    },
    {
      "name": "ready while questioning",
      "op": "ready",
      "expect": {
        "status": 409,
        "error": "only while working"
      }
    }
  ]
}
