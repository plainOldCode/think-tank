{
  "name": "porcelain-empty-pr",
  "description": "Status porcelain skips short lines and keeps the new name of a rename. An empty gh stdout leaves the PR number unset.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4,
    "porcelain": "x\nR  old.py -> turbo/app.py\n M turbo/app.py\n",
    "pr_stdout": ""
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Gate the submit",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working"
      }
    },
    {
      "name": "agent acks",
      "op": "ack",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "agent marks ready",
      "op": "ready",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "harness exits",
      "op": "tick",
      "release": {
        "exit": 0
      },
      "expect": {
        "state": "working"
      }
    },
    {
      "name": "submit parses porcelain",
      "op": "submit",
      "expect": {
        "status": 200,
        "state": "review",
        "verify_level": "unit-test-verified",
        "pr_number": null
      }
    }
  ]
}
