{
  "name": "merge-without-number",
  "description": "A merge with no pull-request number updates the card and does not call gh.",
  "actors": [
    {
      "name": "ada",
      "role": "human"
    },
    {
      "name": "run-1",
      "role": "runner",
      "harnesses": [
        "claude"
      ]
    },
    {
      "name": "worker",
      "role": "agent"
    },
    {
      "name": "probe",
      "role": "probe"
    }
  ],
  "git": {
    "changed": [
      "turbo/app.py"
    ],
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pr_number": 4
  },
  "cards": [
    {
      "ref": "gate",
      "title": "Gate the submit",
      "body": "Implement the gate.",
      "contract": "The runner submits. The agent does not.",
      "harness": "claude",
      "scope": {
        "paths": [
          "turbo/"
        ],
        "forbidden": [],
        "verify": [
          {
            "cmd": "python3 -c \"import sys; raise SystemExit(0)\"",
            "kind": "unit"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "name": "runner claims",
      "op": "tick",
      "arm": {
        "alive": true,
        "exit": 0
      },
      "expect": {
        "state": "working",
        "assignee": "run-1"
      }
    },
    {
      "name": "agent acks",
      "op": "ack",
      "actor": "worker",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "agent marks ready",
      "op": "ready",
      "expect": {
        "status": 200,
        "ready": true
      }
    },
    {
      "name": "submit without a pull request number",
      "op": "submit-raw",
      "work_token": "$token",
      "pr": {},
      "expect": {
        "status": 200,
        "state": "review"
      }
    },
    {
      "name": "probe approves",
      "op": "verdict",
      "result": "approve",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "merge does not call gh",
      "op": "merge",
      "expect": {
        "status": 200,
        "state": "merged",
        "no_merge": true
      }
    }
  ]
}
