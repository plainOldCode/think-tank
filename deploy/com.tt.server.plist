<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.tt.server</string>
<key>ProgramArguments</key><array>
<string>python3</string>
<string>-m</string>
<string>turbo</string>
</array>
<key>WorkingDirectory</key><string>.</string>
<key>EnvironmentVariables</key><dict>
<key>TURBO_DB</key><string>data/turbo.db</string>
<key>TURBO_PORT</key><string>7810</string>
</dict>
<key>KeepAlive</key><true/>
<key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>/tmp/tt-server.log</string>
<key>StandardErrorPath</key><string>/tmp/tt-server.log</string>
</dict></plist>
