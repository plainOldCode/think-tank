#!/usr/bin/env bash
# tt — think-tank issue tracker CLI (server: REST API, see docs/API.md)
set -uo pipefail
URL="${TT_URL:-http://127.0.0.1:7800}"  # serve-time 주입 계약 — 설치본에 실 IP 금지(8a24220 회귀 테스트)
AGENT="${TT_AGENT:-$USER@$(hostname -s)}"
JQ="jq -r"
# TT 개선#3f: CLI 버전 — 서버 openapi 해시와 함께 `tt version`으로 표기(드리프트 감지)
TT_CLI_VERSION="2.7.1"
jfilter() { if [[ "${JSON:-0}" == 1 ]]; then jq .; else jq -r "$@"; fi; }

usage() {
  cat <<EOF
tt — think-tank issue tracker ($URL)
  tt new "title" [-p PARENT] [-b BODY] [-P p1..p4] [-l label,label] [-s backlog|todo]
  tt pull [--label auto] [--hours N]  # todo+만료lease 중 atomic 수령 (cron은 --label 권장, hours 1~6)
  tt heartbeat ID [--hours N]   # 작업 중 lease 연장 (30분 간격 권장)
  tt ping ID                    # alive만 즉시 갱신(선택. TTL·version 불변 — 유효 lease 자체가 보드 깜빡임)
  tt list [state] [--all] [--archived] [--label L]  # 목록 (--label: 라벨 필터, armour+2.0 같은 값 포함)
  tt search "쿼리" [--verification S]  # 제목+본문 검색(한글 URL-인코딩 자동) + 검증 상태 필터
  tt show ID [--machine]     # 상세 + status 3줄(기계 코멘트는 --machine)
  tt tree ID                 # 부모-자식 트리
  tt claim ID [--hours N]      # 특정 이슈 명시적 수령
  tt claim-review ID [--hours N]  # 리뷰어 점유 (review 카드 한정, 본인 작업 409)
  tt label ID add|rm 라벨       # 라벨 부여·제거 (readback 출력)
  tt labels ID set A,B          # 라벨 통째 치환 (빈 값=전체 제거)
  tt unassign ID                # assignee+lease 해제
  tt edit ID [-T 제목] [-b 본문] [-P pN] [-p PARENT] [--assignee A] [--labels a,b] [--state S] [--if-match N]
  tt ... --json                 # (어디든) 서버 원 JSON 그대로 — 스크립트/파이프라인용
  tt note ID "로그"          # 진행 로그 코멘트
  tt contract                # 현재 공통 방법론 조회
  tt submit ID ["로그"] [--report FILE] [--delivery report] [--pr owner/repo#N --head SHA --base NAME]
  tt done ID ["로그"] [--report FILE]  # (submit의 구별칭 — 기존 스크립트 호환)
  tt verify ID ["테스트 결과"] [--report FILE] [--human]  # review → done. --human=사람 자기선언 승인. 자기 카드(assignee)는 verify 불가(409)
  tt state ID STATE          # 상태 이동 (상태 가드 있음)
  tt block ID KIND [-a 액터] [-d 상세]  # blocked 전이+사족 (KIND: dependency|human|gate|external)
  tt why ID                  # why-blocked: 게이트·기준·누락·권장 명령
  tt archive ID|auto         # 아카이브 (auto: 완료 30일 경과분), tt unarchive ID 로 복원
  tt push                    # local 커밋을 중계 리모트(mini:tt-repo)로 push — secret-scan 게이트 내장
  tt agents                  # 등록 agent 목록 (hook 대상)
  tt agent add NAME URL [secret] | tt agent rm NAME | tt agent enable|disable NAME
  tt agent release|notify NAME on|off  # 능력 플래그: release=종지 명령, notify=blocked(human) 알림 수신
  tt dispatch ID -A AGENT "지시"   # 보드→agent webhook 발송(지시는 댓글로 기록, 회신은 comments)
  tt new ... --body-file F    # 다중행 본문을 파일로(셸 인용·백틱 취약 제거)
  tt version                 # cli 버전 + 서버 openapi 해시(스키마 드리프트 감지)
  tt health                  # 서버 점검
EOF
}

# TT 개선#3f: 에러 응답 전문 출력 — 422 validation 배열을 필드명까지 풀어서 보인다.
# ("실패: } ]" 같은 잘림 방지 — 이번 done 디버깅 3회 재시도의 원인)
print_api_err() {
  local body="$1" detail
  detail="$(jq -r '
    if (.detail? | type) == "array"
    then .detail | map("  - \(.loc | map(tostring) | join(".")): \(.msg)") | join("\n")
    elif .detail? != null then (.detail | tostring)
    else (. | tostring) end' <<<"$body" 2>/dev/null)" || detail="$body"
  echo "실패: $detail" >&2
}

req() {
  local response status body
  response="$(curl -sS --max-time 10 -H 'content-type: application/json' -w '\n%{http_code}' "$@")" || return 1
  status="${response##*$'\n'}"; body="${response%$'\n'*}"
  if [[ "$status" != 2?? ]]; then
    print_api_err "$body"
    return 1
  fi
  printf '%s\n' "$body"
}

pr_linked() {
  printf '%s\n' "$1" | grep -Eq 'https?://[^[:space:]"<>]+/(pull|pulls)/[0-9]+|(^|[^A-Za-z0-9_])PR[[:space:]]*#[0-9]+'
}

# Preserve HTTP error detail without repeating a mutating request.
completion_req() {
  local response status body
  response="$(curl -sS --max-time 10 -H 'content-type: application/json' -w '\n%{http_code}' "$@")" || return 1
  status="${response##*$'\n'}"; body="${response%$'\n'*}"
  if [[ "$status" != 2?? ]]; then
    print_api_err "$body"
    return 1
  fi
  printf '%s\n' "$body"
}

show_contract() {
  [[ "$JSON" == 1 ]] && return 0
  jq -r 'select(.work_contract != null) | "[TT contract \(.work_contract.version)] attempt=\(.execution_attempt) report_required=\(.work_contract.report_required // false)\n\(.work_contract.instructions)"' <<<"$1" >&2
}

JSON=0
argv=(); for a in "$@"; do [[ "$a" == --json ]] && JSON=1 || argv+=("$a"); done
set -- ${argv[@]+"${argv[@]}"}
cmd="${1:-help}"; shift || true
[[ $JSON -eq 1 ]] && JQ="jfilter"
case "$cmd" in
  contract)
    req "$URL/work-contract" | $JQ '"[TT contract \(.version)]\n\(.instructions)"' ;;

  version)
    echo "cli $TT_CLI_VERSION"
    # 서버 openapi 해시 — 스키마가 바뀌면 해시가 바뀐다(드리프트 감지 표기).
    # R3: HTTP 상태 확인 전에 해시하지 않는다 — 에러 페이지를 스키마로 오인 방지
    resp="$(curl -sS --max-time 5 -w '\n%{http_code}' "$URL/openapi.json" 2>/dev/null)"
    status="${resp##*$'\n'}"
    if [[ "$status" != 2?? ]]; then
      echo "server openapi 조회 실패 (HTTP ${status:-no-response})" >&2
    else
      echo "server openapi $(printf '%s' "${resp%$'\n'*}" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-8)"
    fi ;;

  health)
    req "$URL/health" | $JQ '"ok: \(.name) \(.status)"' ;;

  new)
    title=""; parent=""; body=""; prio="null"; labels="[]"; state="todo"; acceptance=""; body_file=""
    while [[ $# -gt 0 ]]; do case "$1" in
      -p) parent="$2"; shift 2;; -b) body="$2"; shift 2;; -a) acceptance="$2"; shift 2;;
      --body-file) body_file="$2"; shift 2;;
      -P) prio="$(tr -d pP <<<"$2")"; shift 2;; -l) labels="$(jq -cn --arg L "$2" '$L|split(",")')"; shift 2;;
      -s) state="$2"; shift 2;; *) title="$1"; shift;; esac; done
    [[ -z "$title" ]] && { echo "제목 필요"; exit 1; }
    # TT 개선#3a: 완료 기준 필수 — 자율 pull의 전제(기계가 '끝낼 조건'을 읽어야 함)
    # 공백·탭·개행만 있는 값도 거부(서버 422를 유저에게 보이기 전에 차단)
    [[ -z "${acceptance//[[:space:]]/}" ]] && { echo "acceptance(완료 기준) 필요: tt new \"제목\" -a \"끝낼 조건\""; exit 1; }
    PARENT_JSON=null; [[ -n "$parent" ]] && PARENT_JSON="\"$parent\""
    # TT 개선#3f: 다중행 본문은 파일로 — 셸 인용·백틱 command substitution 취약 제거.
    # R1: jq -Rs가 파일을 직접 읽어 끝 개행·CRLF까지 보존(command substitution은 끝 LF를 잘라버린다)
    # R2: 읽기 실패 시 POST 전에 중단 — 가독성 검사만으론 디렉터리를 못 걸러낸다
    if [[ -n "$body_file" ]]; then
      body_esc="$(jq -Rs . "$body_file")" || { echo "본문 파일을 읽을 수 없음: $body_file" >&2; exit 1; }
    else
      body_esc="$(printf '%s' "$body" | jq -Rs .)"
    fi
    acc_esc="$(printf '%s' "$acceptance" | jq -Rs .)"
    payload="$(jq -cn --arg t "$title" --arg s "$state" --argjson p "$PARENT_JSON" --argjson pr "$prio" --argjson l "$labels" --argjson b "$body_esc" --argjson a "$acc_esc" \
      '{title:$t,state:$s,parent_id:$p,priority:$pr,labels:$l,body:$b,acceptance:$a}')"
    req -X POST "$URL/issues" -d "$payload" | $JQ '.id + " [" + .state + "] " + .title' ;;

  list)
    arch=(); all=0; pos=""
    while [[ $# -gt 0 ]]; do case "$1" in
      --all) all=1; shift ;;
      --archived) arch+=(--data-urlencode "archived=only"); shift ;;
      --label) arch+=(--data-urlencode "label=$2"); shift 2 ;;
      *) pos="$1"; shift ;;
    esac; done
    if [[ -n "$pos" ]]; then
      req --get "$URL/issues" --data-urlencode "state=$pos" --data-urlencode "limit=500" ${arch[@]+"${arch[@]}"}
    elif [[ $all -eq 1 ]]; then
      req --get "$URL/issues" --data-urlencode "limit=500" --data-urlencode "archived=all" ${arch[@]+"${arch[@]}"} | jq -c '[.[] | select(.state!="cancelled")]'
    else
      req --get "$URL/issues" --data-urlencode "limit=500" ${arch[@]+"${arch[@]}"} | jq -c '[.[] | select(.state!="done" and .state!="cancelled")]'
    fi | $JQ 'def badge: if .delayed then " 🟡지연" elif .state=="done" and ((.verification_status // "unverified")=="unverified") then " ⚠unverified" elif .state=="done" and .verification_status=="legacy" then " ⚠legacy" else "" end; .[] | "\(.id)  [\(.state|.[0:4])]  \(.priority|if .==null then "-" else "p"+tostring end)  \(.title)  \(if .assignee!="" then "@"+.assignee else "" end)\(badge)"' ;;

  search)
    q=""; ver=""
    while [[ $# -gt 0 ]]; do case "$1" in
      --verification) ver="$2"; shift 2 ;;
      *) q="$1"; shift ;;
    esac; done
    [[ -z "$q" ]] && { echo "usage: tt search \"쿼리\" [--verification unverified|reported|approved|legacy]" >&2; exit 1; }
    req --get --data-urlencode "q=$q" --data-urlencode "limit=100" "$URL/issues" \
      | { [[ -n "$ver" ]] && $JQ -c --arg v "$ver" '[.[] | select((.verification_status // "unverified") == $v)]' || cat; } \
      | $JQ 'def badge: if .delayed then " 🟡지연" elif .state=="done" and ((.verification_status // "unverified")=="unverified") then " ⚠unverified" elif .state=="done" and .verification_status=="legacy" then " ⚠legacy" else "" end; .[] | "\(.id)  [\(.state|.[0:4])]  \(.priority|if .==null then "-" else "p"+tostring end)  \(.title)  \(if .assignee!="" then "@"+.assignee else "" end)\(badge)"' ;;

  show)
    sid="$1"; show_machine=0; shift
    while [[ $# -gt 0 ]]; do case "$1" in
      --machine) show_machine=1; shift ;;
      *) shift ;;
    esac; done
    dj="$(req "$URL/issues/$sid/dispatches" 2>/dev/null || echo '[]')"
    dtot="$($JQ -r 'length' <<<"$dj" 2>/dev/null || echo '?')"
    dact="$($JQ -r '[.[] | select(.run_state == "running" or .run_state == "queued" or .run_state == "stalled")] | length' <<<"$dj" 2>/dev/null || echo '?')"
    req "$URL/issues/$sid" | $JQ --arg m "$show_machine" --arg dt "$dtot" --arg da "$dact" '
      def machine: test("^(probe|tt-server|tt-embedding-daemon|board)$|^runner@");
      . as $i |
      ([.comments[] | select(.author | machine)] | length) as $mc |
      (.comments | length) as $tc |
      ([.comments[] | select((.author | machine) and (.body | startswith("[tt-delivery-hold")))] | last) as $hold |
      ([.comments[] | select(.author | machine)] | last) as $lastm |
      "■ \(.id) [\(.state)] \(.title)",
      ("  parent: \(.parent_id // "-")  prio: \(.priority // "-")  labels: \(.labels|join(","))  assignee: \(.assignee // "-")" + (if .reviewer then "  🔍reviewer: \(.reviewer)" else "" end) + "  v\(.version)" + (if .state=="done" then "  검증: \(.verification_status // "unverified")" else "" end) + (if .delayed then "  🟡지연(backlog로 내리기: tt state ID backlog)" else "" end)),
      "  -- status --",
      "  카운트: 코멘트 \($tc)건(기계 \($mc)) · dispatch \($dt)회(활성 \($da)) · attempt \(.execution_attempt // 0)",
      (if $lastm then "  변화: \($lastm.body | split("\n")[0] | .[0:90]) (\($lastm.ts))" else empty end),
      (if $hold and $hold.ts == $lastm.ts then "  ⛔gate: delivery-hold — \($hold.body | split("] ")[1] // "?") (\($hold.ts))" else empty end),
      (if .state == "blocked" then "  ⛔gate: blocked — \(.waiting_for // "?") (why: \(.blocked_detail // "-"))" else empty end),
      (if .premise_rework == 1 then "  ⛔premise: 반려 3회+ — premise 재검토 상태 (RPXH)" else empty end),
      "  \(.body|gsub("\n"; "\n  "))",
      (if (.children|length)>0 then "-- 하위 --" else empty end), (.children[] | "  ↳ \(.id) [\(.state)] \(.title)"),
      (if (.comments|length)>0 then "-- 코멘트 --" else empty end),
      (if $m == "1" then (.comments[] | "  \(.ts) \(.author): \(.body)")
       else
         ([.comments[] | select(.author | machine | not)]) as $hc |
         ($tc - ($hc | length)) as $omitted |
         ($hc[] | "  \(.ts) \(.author): \(.body)"),
         (if $omitted > 0 then "  … 기계 코멘트 \($omitted)건 생략 — tt show \(.id) --machine" else empty end)
       end),
      (if (.completion_report.verification.evidence|type)=="array" then
        "-- 구조화 증거 --", (.completion_report.verification.evidence[] | "  ✓ \(.command) (exit \(.exit_code)) \(.output_snippet | .[0:80])") else empty end)' ;;

  tree)
    req "$URL/issues/$1/tree" | $JQ 'def walk(d): ("  "*d) + "■ " + .id + " [\(.state)] " + .title + (if .assignee!="" then " @"+.assignee else "" end) + (if (.tree|length)>0 then "\n" + ([.tree[] | walk(d+1)] | join("\n")) else "" end); walk(0)' ;;

  pull)
    label="" ; hours=""
    while [[ $# -gt 0 ]]; do case $1 in
      --label) label="$2"; shift 2 ;;
      --hours) hours="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    payload="$(jq -cn --arg a "$AGENT" --arg l "$label" --arg h "$hours" '{agent:$a} + (if $l=="" then {} else {require_label:$l} end) + (if $h=="" then {} else {hours:($h|tonumber)} end)')"
    out="$(req -X POST "$URL/pull" -d "$payload")" || { echo "실패: lease 한도(활성 2) 초과 — heartbeat/done 후 재시도" >&2; exit 1; }
    [[ -z "$out" || "$out" == "null" ]] && { echo "받을 작업 없음"; exit 1; }
    show_contract "$out"
    <<<"$out" $JQ '"수령→ ■ \(.id) [\(.state)] \(.title)\n\(.body)"' ;;

  heartbeat)
    id="$1"; shift; hours=""
    [[ "${1:-}" == --hours ]] && hours="$2"
    hb_payload="$(jq -cn --arg a "$AGENT" --arg h "$hours" '{agent:$a} + (if $h=="" then {} else {hours:($h|tonumber)} end)')"
    out="$(req -X POST "$URL/issues/$id/lease" -d "$hb_payload")" || { echo "실패: lease 보유자가 아니거나 만료됨(회수될 수 있음)" >&2; exit 1; }
    <<<"$out" $JQ '"♥ \(.id) lease \(.lease_by) → \(.lease_expires)"' ;;

  ping)
    id="$1"
    out="$(req -X POST "$URL/issues/$id/ping" -d "$(jq -cn --arg a "$AGENT" '{agent:$a}')")" || { echo "실패: lease 보유자가 아니거나 만료됨" >&2; exit 1; }
    <<<"$out" $JQ '"● \(.id) alive \(.heartbeat_at)"' ;;

  claim)
    [[ $# -lt 1 ]] && { echo "usage: tt claim ID [--hours N]" >&2; exit 1; }
    id="$1"; shift; hours=""
    [[ "${1:-}" == --hours ]] && hours="$2"
    cl_payload="$(jq -cn --arg a "$AGENT" --arg h "$hours" '{agent:$a} + (if $h=="" then {} else {hours:($h|tonumber)} end)')"
    out="$(req -X POST "$URL/issues/$id/claim" -d "$cl_payload")" || { echo "실패: 수령 불가(상태/선점 확인)" >&2; exit 1; }
    show_contract "$out"
    <<<"$out" $JQ '"■ \(.id) [\(.state)] \(.title) @\(.assignee)"' ;;

  claim-review)
    # TT 개선#3c: 리뷰어 점유 — review 카드만, 본인 작업 카드는 409(교차리뷰)
    [[ $# -lt 1 ]] && { echo "usage: tt claim-review ID [--hours N]" >&2; exit 1; }
    id="$1"; shift; hours=""
    [[ "${1:-}" == --hours ]] && hours="$2"
    cr_payload="$(jq -cn --arg a "$AGENT" --arg h "$hours" '{agent:$a} + (if $h=="" then {} else {hours:($h|tonumber)} end)')"
    out="$(req -X POST "$URL/issues/$id/claim-review" -d "$cr_payload")" || { echo "실패: review 카드가 아니거나 본인 작업 카드(교차리뷰 금지)/이중 점유" >&2; exit 1; }
    <<<"$out" $JQ '"◆ \(.id) [\(.state)] 리뷰어 \(.reviewer) — 판정 후 TT 코멘트 + PR 코멘트 양쪽 게시"' ;;

  note)
    req -X POST "$URL/issues/$1/comments" -d "$(jq -cn --arg a "$AGENT" --arg b "$2" '{author:$a,body:$b}')" >/dev/null || { echo "실패: 코멘트" >&2; exit 1; }
    echo "note ok" ;;

  done|submit|verify)
    [[ $# -lt 1 ]] && { echo "usage: tt $cmd ID [text] [--report FILE] [--delivery report] [--pr owner/repo#N --head SHA --base NAME]" >&2; exit 1; }
    id="$1"; shift; summary=""; report_file=""; delivery_mode=""; pr_ref=""; head_sha=""; base_ref=""; human_flag=""
    while [[ $# -gt 0 ]]; do case "$1" in
      --human)
        [[ "$cmd" != verify ]] && { echo "--human은 verify 전용" >&2; exit 1; }
        human_flag=1; shift ;;
      --report)
        [[ $# -lt 2 ]] && { echo "--report FILE 필요" >&2; exit 1; }
        report_file="$2"; shift 2 ;;
      --delivery)
        [[ $# -lt 2 ]] && { echo "--delivery report 필요" >&2; exit 1; }
        delivery_mode="$2"; shift 2 ;;
      --pr)
        [[ $# -lt 2 ]] && { echo "--pr owner/repo#번호 필요" >&2; exit 1; }
        pr_ref="$2"; shift 2 ;;
      --head)
        [[ $# -lt 2 ]] && { echo "--head 전체 SHA 필요" >&2; exit 1; }
        head_sha="$2"; shift 2 ;;
      --base)
        [[ $# -lt 2 ]] && { echo "--base 필요" >&2; exit 1; }
        base_ref="$2"; shift 2 ;;
      *) summary="$1"; shift ;;
    esac; done
    if [[ "$cmd" != verify ]]; then
      if [[ -n "$delivery_mode" && "$delivery_mode" != report ]]; then
        echo "delivery는 report만 명시한다. PR은 --pr owner/repo#N --head SHA --base NAME" >&2
        exit 1
      fi
      if [[ -n "$pr_ref$head_sha$base_ref" ]]; then
        [[ "$delivery_mode" == report ]] && { echo "--delivery report와 --pr은 함께 쓸 수 없다" >&2; exit 1; }
        [[ -n "$report_file" ]] || { echo "--pr은 --report와 함께" >&2; exit 1; }
        [[ "$pr_ref" =~ ^[^[:space:]#]+/[^[:space:]#]+#[0-9]+$ ]] || { echo "--pr은 owner/repo#번호" >&2; exit 1; }
        [[ "$head_sha" =~ ^[0-9a-fA-F]{40}$ || "$head_sha" =~ ^[0-9a-fA-F]{64}$ ]] || { echo "--head는 전체 SHA(40 또는 64 hex)" >&2; exit 1; }
        [[ -n "$base_ref" ]] || { echo "--base 필요" >&2; exit 1; }
      fi
      existing=""
      if [[ -n "$report_file" ]]; then
        existing="$(jq -er 'if has("delivery") then .delivery.mode else "" end' "$report_file" 2>/dev/null)" || { echo "report JSON이 아님" >&2; exit 1; }
        if [[ -n "$existing" && ( -n "$delivery_mode" || -n "$pr_ref" ) ]]; then
          echo "보고에 delivery가 이미 있다. CLI가 덮어쓰지 않는다" >&2
          exit 1
        fi
      fi
      blob="$summary"
      [[ -n "$report_file" ]] && blob+=$'\n'"$(cat "$report_file")"
      issue_json="$(req "$URL/issues/$id")" || exit 1
      blob+=$'\n'"$(jq -r '.body // "", ((.comments // [])[].body // "")' <<<"$issue_json")"
      if [[ -z "$existing" && -z "$pr_ref" && "$delivery_mode" != report ]] && pr_linked "$blob"; then
        echo "PR이 보이는데 delivery가 없다. 제출 전에 --pr owner/repo#N --head SHA --base NAME 또는 --delivery report" >&2
        exit 1
      fi
    fi
    if [[ "$cmd" != verify ]]; then payload='{"state":"done"}'
    else payload="$(jq -cn --arg a "$AGENT" --arg e "$summary" --arg h "$human_flag" \
      '{verifier:$a,evidence:$e} + (if $h=="1" then {human:true} else {} end)')"; fi
    if [[ -n "$report_file" ]]; then
      payload="$(jq -cn --argjson p "$payload" --slurpfile r "$report_file" \
        'if ($r|length)==1 and ($r[0]|type)=="object" then $p + {completion_report:$r[0]} else error("one report object required") end')" || exit 1
    fi
    if [[ "$cmd" != verify && -n "$report_file" && -z "$existing" ]]; then
      if [[ -n "$pr_ref" ]]; then
        payload="$(jq -cn --argjson p "$payload" --arg repo "${pr_ref%%#*}" --argjson n "${pr_ref##*#}" \
          --arg head "$(printf '%s' "$head_sha" | tr 'A-F' 'a-f')" --arg base "$base_ref" \
          '$p | .completion_report.delivery = {mode:"pr", provider:"github", repo:$repo, number:$n, head_sha:$head, base:$base}')" || exit 1
      else
        payload="$(jq -cn --argjson p "$payload" '$p | .completion_report.delivery = {mode:"report"}')" || exit 1
      fi
    fi
    if [[ "$cmd" != verify ]]; then
      if [[ -n "$summary" ]]; then
        completion_req -X POST "$URL/issues/$id/comments" -d "$(jq -cn --arg a "$AGENT" --arg b "$summary" '{author:$a,body:$b}')" >/dev/null || exit 1
      fi
      out="$(completion_req -X PATCH "$URL/issues/$id" -d "$payload")" || exit 1
    else
      out="$(completion_req -X POST "$URL/issues/$id/verify" -d "$payload")" || exit 1
    fi
    if [[ "$JSON" == 1 ]]; then
      jq . <<<"$out"
    elif [[ "$(jq -r '.state' <<<"$out")" == review ]]; then
      echo "◆ $id → review (성공 결과 보고 필요)"
      echo "  확정: TT 독립 승인 → 선택한 delivery 확인 → verify (report=보고가 산출물, pr=병합 확인 필수. local은 저장 호환)"
      echo "  판정 대상: $(jq -r '.review_subject // "legacy — 서버 규약 확인"' <<<"$out")"
      echo "  동일 회차 수정: tt submit $id --report report.json 재제출 / 새 회차: todo → claim"
    else
      jq -r '"✓ \(.id) \(.title) 완료 \(.completed_at) [\(.verification_status // "legacy")]"' <<<"$out"
    fi ;;

  state)
    [[ $# -lt 2 ]] && { echo "usage: tt state ID STATE" >&2; exit 1; }
    out="$(req -X PATCH "$URL/issues/$1" -d "{\"state\":\"$2\"}")" || { echo "실패: 존재하지 않거나 금지된 전이" >&2; exit 1; }
    <<<"$out" $JQ '"■ \(.id) → \(.state)"' ;;

  block)
    [[ -z "${2:-}" ]] && { echo "usage: tt block ID <dependency|human|gate|external> [-a 책임액터] [-d 상세/의존ID] [-q 질문] [-o 선택지1,선택지2] [-f 무응답기본값]" >&2; echo "  blocked 전이는 질문·선택지·기본값이 필수입니다(HDPB — 사람이 무엇을 판단할지 명시)" >&2; exit 1; }
    id="$1"; kind=""; actor=""; detail=""; question=""; options=""; dflt=""
    shift 1
    while [[ $# -gt 0 ]]; do case "$1" in
      dependency|human|gate|external) kind="$1"; shift ;;
      -a) actor="${2:-}"; shift 2 ;;
      -d) detail="${2:-}"; shift 2 ;;
      -q) question="${2:-}"; shift 2 ;;
      -o) options="${2:-}"; shift 2 ;;
      -f) dflt="${2:-}"; shift 2 ;;
      *) shift ;;
    esac; done
    [[ -z "$kind" ]] && { echo "실패: blocked 종류(dependency|human|gate|external) 필요" >&2; exit 1; }
    payload="$(jq -cn --arg w "$kind" --arg a "$actor" --arg d "$detail" --arg q "$question" --arg o "$options" --arg f "$dflt" '
      {state:"blocked",waiting_for:$w}
      + (if $a=="" then {} else {waiting_actor:$a} end)
      + (if $d=="" then {} else {blocked_detail:$d} end)
      + (if $q=="" then {} else {blocked_question:$q} end)
      + (if $o=="" then {} else {blocked_options:($o|split(","))} end)
      + (if $f=="" then {} else {blocked_default:$f} end)')"
    out="$(req -X PATCH "$URL/issues/$id" -d "$payload")" || { echo "실패: blocked 전이/필드 확인 — 질문(-q)·선택지(-o)·기본값(-f) 누락 여부 확인" >&2; exit 1; }
    <<<"$out" $JQ '"■ \(.id) → blocked (waiting_for=\(.waiting_for) actor=\(.waiting_actor // "-"))  질문: \(.blocked_question // "-")  선택지: \(.blocked_options // "-")  기본값: \(.blocked_default // "-")"' ;;

  why)
    req "$URL/issues/$1/why-blocked" | $JQ '"gate: \(.gate.kind)  actor: \(.waiting_actor // "-")", "기준: \(.criteria)", (if (.dependencies|length)>0 then "의존: " + ([.dependencies[] | "\(.id)=\(.state)"]|join(", ")) + "  누락: " + (.missing|if length>0 then join(",") else "없음" end) + "  해제가능: \(.release_ready)" else empty end), "근거: \(.evidence // "-")", "권장: " + (.next_commands|join("  |  "))' ;;

  label)
    [[ $# -lt 3 ]] && { echo "usage: tt label ID add|rm 라벨" >&2; exit 1; }
    id="$1"; op="$2"; lab="$3"; ver="${5:-}"   # tt label ID add L --if-match N
    cur="$(req "$URL/issues/$id" | jq -r '.labels|join(",")')"
    payload="$(jq -cn --arg c "$cur" --arg l "$lab" --arg op "$op" --arg v "$ver" '
      ($c|split(",")|map(select(.!=""))) as $cur
      | (if $op=="add" then ($cur + [$l]|unique) elif $op=="rm" then ($cur - [$l]) else null end) as $new
      | if $new==null then error("op는 add|rm") else {labels:$new} + (if $v=="" then {} else {expected_version:($v|tonumber)} end) end')"
    out="$(req -X PATCH "$URL/issues/$id" -d "$payload")" || { echo "실패: 라벨 수정 거부(버전 충돌 확인)" >&2; exit 1; }
    <<<"$out" $JQ '"🏷 \(.id) labels: \(.labels|join(",")) v\(.version)"' ;;

  edit)
    id="$1"; shift
    payload="{}"
    while [[ $# -gt 0 ]]; do case $1 in
      -T) payload="$(jq -cn --argjson p "$payload" --arg v "$2" '$p + {title:$v}')"; shift 2 ;;
      -b) payload="$(jq -cn --argjson p "$payload" --arg v "$2" '$p + {body:$v}')"; shift 2 ;;
      -P) payload="$(jq -cn --argjson p "$payload" --arg v "${2#p}" '$p + {priority:($v|tonumber)}')"; shift 2 ;;
      -p) payload="$(jq -cn --argjson p "$payload" --arg v "$2" '$p + {parent_id:$v}')"; shift 2 ;;
      --assignee) payload="$(jq -cn --argjson p "$payload" --arg v "$2" '$p + {assignee:$v}')"; shift 2 ;;
      --labels) payload="$(jq -cn --argjson p "$payload" --arg v "$2" '$p + {labels:($v|split(",")|map(select(.!="")))}')"; shift 2 ;;
      --state) payload="$(jq -cn --argjson p "$payload" --arg v "$2" '$p + {state:$v}')"; shift 2 ;;
      --if-match) payload="$(jq -cn --argjson p "$payload" --arg v "$2" '$p + {expected_version:($v|tonumber)}')"; shift 2 ;;
      *) shift ;;
    esac; done
    [[ "$payload" == "{}" ]] && { echo "usage: tt edit ID [-T][-b][-P][-p][--assignee][--labels][--state][--if-match]" >&2; exit 1; }
    out="$(req -X PATCH "$URL/issues/$id" -d "$payload")" || { echo "실패: 수정 거부(상태/버전 충돌 확인)" >&2; exit 1; }
    <<<"$out" $JQ '"✎ \(.id) \(.title) prio:\(.priority // "-") parent:\(.parent_id // "-") v\(.version)"' ;;

  archive)
    if [[ "${1:-}" != "auto" ]]; then
      req -X PATCH "$URL/issues/$1" -d '{"archived":true}' >/dev/null || { echo "실패" >&2; exit 1; }
      echo "archived $1"; exit 0
    fi
    cutoff="$(date -d '30 days ago' +%FT%T 2>/dev/null || date -v-30d +%FT%T)"
    n=0
    for id in $(req "$URL/issues?state=done" | jq -r --arg c "$cutoff" '.[] | select(.completed_at < $c) | .id'); do
      req -X PATCH "$URL/issues/$id" -d '{"archived":true}' >/dev/null && n=$((n+1))
    done
    echo "$n건 자동 아카이브 (완료 30일 경과)" ;;

  unarchive)
    req -X PATCH "$URL/issues/$1" -d '{"archived":false}' >/dev/null || { echo "실패" >&2; exit 1; }
    echo "unarchived $1" ;;

  unassign)
    out="$(req -X PATCH "$URL/issues/$1" -d '{"assignee":""}')" || { echo "실패: 존재하지 않음" >&2; exit 1; }
    <<<"$out" $JQ '"→ \(.id) assignee 해제(lease 소거 포함) [\(.state)]"' ;;

  labels)
    [[ "${2:-}" != set ]] && { echo "usage: tt labels ID set A,B(통째 치환, 빈 값=전체 제거)" >&2; exit 1; }
    lb_payload="$(jq -cn --arg l "${3:-}" '{labels:($l|split(",")|map(select(.!="")))}')"
    out="$(req -X PATCH "$URL/issues/$1" -d "$lb_payload")" || { echo "실패: 라벨 set 거부" >&2; exit 1; }
    <<<"$out" $JQ '"🏷 \(.id) labels: \(.labels|join(",")) v\(.version)"' ;;

  push)
    repo="${TT_REPO:-$HOME/think-tank}"
    branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"
    # 이미 공개된 과거 내용은 새 push를 막지 않는다: push 대상 구간만 스캔.
    base="$(git -C "$repo" rev-parse '@{push}' 2>/dev/null \
      || git -C "$repo" rev-parse "origin/$branch" 2>/dev/null \
      || echo HEAD)"
    (cd "$repo" && TT_SCAN_DIFF="$base" scripts/secret-scan.sh .) || { echo "비밀 스캔 실패 — push 중단 (위 패턴 확인)" >&2; exit 1; }
    (cd "$repo" && TT_STALE_WARN=1 scripts/stale-base-check.sh . "origin/main")  # 뒤처진 base 경고 — push는 진행, PR 생성 전 재기반 권장
    unpushed="$(git -C "$repo" log --oneline @{push}.. 2>/dev/null || git -C "$repo" log --oneline origin/"$branch".."$branch" 2>/dev/null || git -C "$repo" log --oneline -1)"
    [[ -n "$(git -C "$repo" status --porcelain)" ]] && echo "경고: 커밋되지 않은 변경 있음 (push 대상 아님)" >&2
    git -C "$repo" push -q mini:tt-repo "$branch" >/dev/null || { echo "실패: mini 중계 push" >&2; exit 1; }
    out="$(ssh -o BatchMode=yes mini "export PATH=/opt/homebrew/bin:\$PATH; git -C ~/tt-repo fetch -q origin && git -C ~/tt-repo push origin $branch 2>&1 | tail -3")"       || { echo "실패: GitHub push (mini 중계만 반영됨 — mini에서 git -C ~/tt-repo push origin $branch)" >&2; echo "$out" >&2; exit 1; }
    case "$out" in *rejected*|*non-fast-forward*|*error*) echo "실패: GitHub push — $out" >&2; exit 1;; esac
    echo "push: ${unpushed:-커밋 없음} → $out" ;;

  agents)
    # RZ20: model/reasoning/tier 접미 — 기존 접두(name·base_url·on/off·ok/err) 포맷 유지(후방호환).
    # RZ20-F3: 세 필드는 독립 선택값 — model 없이도 reasoning/tier 표시.
    req "$URL/agents" | $JQ '.[] | "\(.name)  \(.base_url)  \(if .enabled==1 then "on" else "off" end)  ok=\(.last_ok // "-")  err=\(.last_err // "")" + (if (.model or .reasoning or .tier) then (if .model then "  model=\(.model)\(if .reasoning then "/\(.reasoning)" else "" end)" elif .reasoning then "  reasoning=\(.reasoning)" else "" end) + (if .tier then " [\(.tier)]" else "" end) else "" end)' ;;

  agent)
    sub="${1:-}"; [[ -z "$sub" ]] && { echo "usage: tt agent add NAME URL [secret] [--receive-mode hook|watcher|relay] [--watcher-interval MIN] [--model M] [--reasoning R] [--tier T] | set NAME key=val... | rm NAME | enable|disable NAME | release|notify NAME on|off" >&2; exit 1; }
    case "$sub" in
      add)
        [[ $# -lt 3 ]] && { echo "usage: tt agent add NAME URL [secret] [--receive-mode hook|watcher|relay] [--watcher-interval MIN] [--aliases a,b,c] [--model M] [--reasoning R] [--tier T]" >&2; exit 1; }
        name="$2"; url="$3"; secret=""
        shift 3   # 남은 것: [secret] 또는 옵션들
        if [[ $# -gt 0 && "$1" != --* ]]; then secret="$1"; shift; fi
        payload="$(jq -n --arg n "$name" --arg u "$url" --arg s "$secret" '{name:$n, base_url:$u, secret:$s}')"
        while [[ $# -gt 0 ]]; do case "$1" in
          --receive-mode|--watcher-interval|--aliases)
            [[ $# -ge 2 ]] || { echo "값 누락: $1 (사용법: $1 값)" >&2; exit 1; }
            if [[ "$1" == --receive-mode ]]; then
              payload="$(echo "$payload" | jq --arg v "$2" '. + {receive_mode:$v}')"
            elif [[ "$1" == --aliases ]]; then
              payload="$(echo "$payload" | jq --arg v "$2" '. + {aliases:($v | split(","))}')"
            else
              payload="$(echo "$payload" | jq --argjson v "$2" '. + {watcher_interval:$v}')"
            fi; shift 2 ;;
          --model|--reasoning|--tier)
            [[ $# -ge 2 ]] || { echo "값 누락: $1 (사용법: $1 값)" >&2; exit 1; }
            payload="$(echo "$payload" | jq --arg k "${1#--}" --arg v "$2" '. + {($k):$v}')"; shift 2 ;;
          *) echo "알 수 없는 옵션: $1" >&2; exit 1 ;;
        esac; done
        req -X POST "$URL/agents" -d "$payload" | $JQ '"등록: \(.name) → \(.base_url)  수신계약: \(.receive_mode // "미선언(claim 409)")" + (if .receive_mode == "watcher" then " 주기=\(.watcher_interval)분" else "" end) + (if (.model or .reasoning or .tier) then (if .model then "  model=\(.model)\(if .reasoning then "/\(.reasoning)" else "" end)" elif .reasoning then "  reasoning=\(.reasoning)" else "" end) + (if .tier then " [\(.tier)]" else "" end) else "" end)' ;;
      set)
        [[ $# -lt 3 ]] && { echo "usage: tt agent set NAME model=M reasoning=R tier=T receive_mode=... aliases=a,b" >&2; exit 1; }
        name="$2"; shift 2
        payload='{}'
        for kv in "$@"; do k="${kv%%=*}"; v="${kv#*=}"; [[ "$k" == "$v" ]] && { echo "key=val 형식: $kv" >&2; exit 1; }
          if [[ "$k" == aliases ]]; then
            payload="$(echo "$payload" | jq --arg v "$v" '. + {aliases:($v | if . == "" then [] else split(",") end)}')"
          else
            payload="$(echo "$payload" | jq --arg k "$k" --arg v "$v" '. + {($k):$v}')"
          fi
        done
        req -X PATCH "$URL/agents/$name" -d "$payload" | $JQ '"\(.name): receive_mode=\(.receive_mode // "-")\(if .receive_mode == "watcher" then "(주기 \(.watcher_interval // "-")분)" else "" end) model=\(.model // "-") reasoning=\(.reasoning // "-") tier=\(.tier // "-") 별칭=\((.aliases // []) | join(","))"' ;;
      rm)
        req -X DELETE "$URL/agents/$2" | $JQ '"삭제: \(.ok)"' ;;
      enable|disable)
        [[ "$sub" == enable ]] && v=true || v=false
        req -X PATCH "$URL/agents/$2" -d "{\"enabled\":$v}" | $JQ '"\(.name): \(if .enabled==1 then "활성" else "비활성" end)"' ;;
      release|notify)
        # 능력 플래그 토글: release=terminalize 중지 명령 수신(runner), notify=blocked(human) Level4 알림 수신(어댑터)
        [[ $# -lt 3 ]] && { echo "usage: tt agent $sub NAME on|off" >&2; exit 1; }
        [[ "$3" == on ]] && v=true || v=false
        req -X PATCH "$URL/agents/$2" -d "{\"${sub}_hook\":$v}" | $JQ "\"\\(.name): ${sub}_hook=\\(.${sub}_hook)\"" ;;
      *) usage; exit 1 ;;
    esac ;;

  dispatch)
    [[ -z "${1:-}" ]] && { echo "usage: tt dispatch ID -A AGENT "지시" [-a author]" >&2; exit 1; }
    id="$1"; shift; agent=""; author="$AGENT"; msg=""
    while [[ $# -gt 0 ]]; do case $1 in
      -A) agent="${2:-}"; shift 2 ;;
      -a) author="${2:-}"; shift 2 ;;
      *) msg="$1"; shift ;;
    esac; done
    [[ -z "$agent" || -z "$msg" ]] && { echo "usage: tt dispatch ID -A AGENT "지시"" >&2; exit 1; }
    payload="$(jq -n --arg a "$agent" --arg m "$msg" --arg au "$author" '{agent:$a, message:$m, author:$au}')"
    out="$(curl -sf --max-time 25 -H 'content-type: application/json' -X POST "$URL/issues/$id/dispatch" -d "$payload")" || { echo "dispatch 요청 실패" >&2; exit 1; }
    echo "$out" | $JQ '"dispatch #\(.id) → \(.agent): \(.status) \(.detail)"' ;;

  help|*) usage ;;
esac
